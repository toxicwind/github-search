{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ghas/contracts": ["packages/contracts/src/index.ts"],
      "@ghas/github-client": ["packages/github-client/src/index.ts"],
      "@ghas/search-core": ["packages/search-core/src/index.ts"]
    }
  }
}
