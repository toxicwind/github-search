{
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4"
  },
  "name": "@ghas/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts --mode http",
    "start": "bun src/server.ts --mode http",
    "debug": "bun --inspect=0.0.0.0:9230 --watch src/server.ts --mode http",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "start:prod": "bun dist/server.js --mode http"
  },
  "dependencies": {
    "@ghas/contracts": "workspace:*",
    "@ghas/github-client": "workspace:*",
    "@ghas/search-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.1"
  }
}